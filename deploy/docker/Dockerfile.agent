# =============================================================================
# Dockerfile.agent - Agent Worker 镜像
#
# Celery Worker 用于处理异步任务和 Agent 工作流
# 适用于服务拆分部署场景
# =============================================================================

FROM python:3.11-slim as builder

WORKDIR /app

# 安装构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY pyproject.toml ./
RUN pip install --no-cache-dir build && \
    pip wheel --no-cache-dir --wheel-dir /app/wheels -e .

# 生产镜像
FROM python:3.11-slim

WORKDIR /app

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash appuser

# 安装 Python 包
COPY --from=builder /app/wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

# 复制代码
COPY backend/ ./backend/

# 创建数据目录
RUN mkdir -p /app/data/sqlite /app/data/faiss /app/data/bm25 /app/data/uploads /app/logs && \
    chown -R appuser:appuser /app

USER appuser

# 环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV APP_ENV=production
ENV C_FORCE_ROOT=false

# Agent Worker 没有端口暴露

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD celery -A backend.app.core.celery_app inspect ping -d celery@$HOSTNAME || exit 1

CMD ["celery", "-A", "backend.app.core.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
