# Application
APP_NAME=AI Learning Assistant
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db
# For production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/learning_assistant

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector Store
VECTOR_STORE_PATH=./data/chromadb
VECTOR_COLLECTION_NAME=questions

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Default LLM Provider (openai or anthropic)
DEFAULT_LLM_PROVIDER=openai

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# For local embedding model:
# LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Celery (for production)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO

