# ==============================================
# AI 学习小书童 - 环境变量配置
# ==============================================

# ============ Application ============
APP_NAME="AI Learning Assistant"
APP_VERSION=0.1.0
APP_ENV=development  # development, staging, production
DEBUG=true

# ============ Server ============
HOST=0.0.0.0
# PORT - 每个模块使用自己的端口号（rpj:6001, xmx:6002, wzy:6003, wzm:6004, tony:6005）
# 不要在这里设置全局 PORT，让各模块使用 config.py 中定义的默认值
WORKERS=1
RELOAD=true

# ============ Public API URL ============
# 用于生成外部可访问的URL（如图片URL等）
# 格式: http://106.63.100.63:30284 或 https://example.com
# 如果不设置，将使用 HOST:PORT 组合
# PUBLIC_API_BASE_URL=http://106.63.100.63:30284

# ============ Font Configuration ============
# 中文字体路径（用于批改图片中的中文显示）
# 如果不设置，系统会自动查找系统中的中文字体
# 如果系统没有中文字体，批改图片中的中文会显示为方框
# 安装中文字体：
#   Ubuntu/Debian: sudo apt-get install fonts-wqy-microhei fonts-wqy-zenhei
#   CentOS/RHEL: sudo yum install wqy-microhei-fonts wqy-zenhei-fonts
# FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc

# ============ Security ============
SECRET_KEY=your-super-secret-key-change-in-production

# ============ CORS ============
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ============ Database (SQLite) ============
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ Vector Store (FAISS + BM25) ============
VECTOR_STORE_PATH=./data/faiss
BM25_INDEX_PATH=./data/bm25
VECTOR_COLLECTION_NAME=questions

# Hybrid Search Configuration
HYBRID_SEARCH_VECTOR_WEIGHT=0.6
HYBRID_SEARCH_BM25_WEIGHT=0.4
HYBRID_SEARCH_SIMILARITY_THRESHOLD=0.55
HYBRID_SEARCH_TOP_K=20

# ============ LLM API Endpoint (统一接口) ============
LLM_API_ENDPOINT=http://35.220.164.252:3888/v1
LLM_API_KEY=sk-xxx

# ============ Gemini API (OCR & Analysis) ============
# 注意：已改为使用 LLM_API_ENDPOINT，以下配置保留以兼容旧版
#GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_THINKING_BUDGET=16384
#GEMINI_IMAGE_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3-flash-preview

# ============ Multi-Model Ensemble (Recommended) ============
# 最佳实践：OCR 用快模型（如 gemini-2.5-flash），分类/归一化/学科判定用强模型（如 gemini-3-pro-preview、gpt-5.2）
# tony 模块：建议将“图像OCR(多模态)”与“文本深度推理(LLM)”分开配置
# 1) OCR（多模态）：用于图片解析（建议快模型）
TONY_OCR_VISION_MODEL=gemini-3-flash-preview
# 2) 文本深度推理（LLM）：用于学科判定、分类、错因分析、总结等（建议强模型，支持多模型兜底）
TONY_TEXT_REASONING_MODELS=gemini-3-pro-preview,gpt-5.2
# Text reasoning / deep analysis timeout (seconds)
TONY_TEXT_REASONING_TIMEOUT_SECONDS=90
# When Reasoner falls back, store truncated raw model output preview for observability
TONY_REASONER_RAW_PREVIEW_CHARS=1200
#
# 说明：已移除旧的“高精度模型”变量，统一使用上面的 OCR/文本推理分离配置
#
# 分类发散控制：允许模型返回 NEW:xxx 作为新分类，但会做“新增数量门控”
TONY_MAX_NEW_CHAPTERS_PER_REQUEST=2
TONY_MAX_NEW_KPS_PER_REQUEST=6

# 深度解析控制（图片/文字都会走 Reasoner；可按需调整成本）
TONY_DEEP_ENRICH_MAX_ITEMS=10
TONY_SUBJECT_MISMATCH_CONFIDENCE=0.75

# ============ OpenAI (Optional) ============
OPENAI_MODEL=gpt-4-turbo-preview

# ============ Anthropic (Optional) ============
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============ Default LLM Provider ============
DEFAULT_LLM_PROVIDER=openai  # openai, anthropic, gemini

# ============ Embedding ============
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# For local embedding model (recommended for Chinese):
# LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ============ Celery Task Queue ============
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============ Logging ============
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============ Docker Deployment ============
# For docker-compose, use these values:
# VITE_API_BASE_URL=http://localhost:8000
