# ==============================================
# AI 学习小书童 - 环境变量配置
# ==============================================

# ============ Application ============
APP_NAME=AI Learning Assistant
APP_VERSION=0.1.0
APP_ENV=development  # development, staging, production
DEBUG=true

# ============ Server ============
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# ============ Security ============
SECRET_KEY=your-super-secret-key-change-in-production

# ============ CORS ============
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ Database (SQLite) ============
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ Vector Store (FAISS + BM25) ============
VECTOR_STORE_PATH=./data/faiss
BM25_INDEX_PATH=./data/bm25
VECTOR_COLLECTION_NAME=questions

# Hybrid Search Configuration
HYBRID_SEARCH_VECTOR_WEIGHT=0.6
HYBRID_SEARCH_BM25_WEIGHT=0.4
HYBRID_SEARCH_SIMILARITY_THRESHOLD=0.55
HYBRID_SEARCH_TOP_K=20

# ============ LLM API Endpoint (统一接口) ============
LLM_API_ENDPOINT=your-llm-api-endpoint
LLM_API_KEY=your-llm-api-key

# ============ Gemini API (OCR & Analysis) ============
# 注意：已改为使用 LLM_API_ENDPOINT，以下配置保留以兼容旧版
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=16384
GEMINI_IMAGE_MODEL=gemini-2.5-flash

# ============ OpenAI (Optional) ============
OPENAI_MODEL=gpt-4-turbo-preview

# ============ Anthropic (Optional) ============
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============ Default LLM Provider ============
DEFAULT_LLM_PROVIDER=openai  # openai, anthropic, gemini

# ============ Embedding ============
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# For local embedding model (recommended for Chinese):
# LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ============ Celery Task Queue ============
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============ Logging ============
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============ Docker Deployment ============
# For docker-compose, use these values:
# VITE_API_BASE_URL=http://localhost:8000
