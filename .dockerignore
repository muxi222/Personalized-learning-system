# =============================================================================
# Docker Ignore - 排除不需要复制到镜像的文件
# =============================================================================

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
env/
.eggs/
*.egg-info/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Data directories (mounted as volumes)
data/
logs/
*.log

# Database files
*.db
*.sqlite
*.sqlite3

# Model files (too large for image)
*.bin
*.safetensors
*.gguf
models/

# Secrets
.env
.env.*
*.pem
*.key
secrets.yaml
secrets.json

# Node modules
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/

# Documentation (not needed in runtime)
docs/
*.md
!README.md

# Tests
tests/
**/tests/
pytest.ini
.coveragerc

# Development files
Makefile
docker-compose*.yml
deploy/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Celery
celerybeat-schedule
celerybeat.pid

# Misc
*.bak
*.tmp
temp/
tmp/
